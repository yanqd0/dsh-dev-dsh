{
  "name": "@yanqd0/dsh-dev-dsh",
  "version": "0.2.0-alpha.1",
  "description": "dsh plugin for developing dsh plugins: ships the out-of-tree authoring method as a skill that installs with the plugin, plus opt-in experimental submodules",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yanqd0/dsh-dev-dsh.git"
  },
  "homepage": "https://github.com/yanqd0/dsh-dev-dsh#readme",
  "bugs": {
    "url": "https://github.com/yanqd0/dsh-dev-dsh/issues"
  },
  "engines": {
    "node": ">=22.19"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "out-of-tree",
    "skill"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./client": {
      "default": "./dist/client.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "cordis.patch.yml",
    "locale",
    "scripts/install-skill-postinstall.mjs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsup && node scripts/build-client.mjs && node scripts/build-skill.mjs",
    "postinstall": "node scripts/install-skill-postinstall.mjs",
    "dogfood:skill": "node dist/install-skill.js --link --source skill",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check-types": "tsc --noEmit",
    "pack:check": "pnpm pack --dry-run"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.19.0",
    "@vitest/coverage-v8": "^3.2.7",
    "esbuild": "^0.27.7",
    "eslint": "^9.39.5",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.9",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "zod": "^3.25.76"
  }
}
