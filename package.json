{
  "name": "@yanqd0/dsh-dev-dsh",
  "version": "0.1.0-alpha.1",
  "description": "A dsh plugin for developing dsh plugins: ships the out-of-tree authoring method as a skill that installs with the plugin",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.19"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "skill"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src",
    "format": "prettier --write .",
    "check-types": "tsc --noEmit",
    "pack:check": "pnpm pack --dry-run"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.19.0",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.39.5",
    "prettier": "^3.9.9",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^3.2.7"
  }
}
